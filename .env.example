# Cấu hình Firebase Web SDK (Lấy từ Firebase Console -> Project Settings -> General -> Your apps)
# Lưu ý: firebaseConfig phía client là định danh ứng dụng công khai, KHÔNG phải secret.
# Bảo mật dữ liệu thực tế được cưỡng chế bởi Firestore Security Rules (firestore.rules).

VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Đặt thành "true" khi muốn kết nối với Firebase Local Emulator Suite (Auth: 9099, Firestore: 8080)
VITE_USE_FIREBASE_EMULATOR="false"

